<%# Rozpoznanie MOBILNEJ APLIKÁCIE (Google Play / nainštalovaná PWA).
    Beží ešte pred vykreslením stránky, aby appkový vzhľad nebliknul.
    Appka = režim standalone ALEBO karta otvorená z appky (sessionStorage —
    platí len pre danú kartu, takže web v Chrome na tom istom telefóne
    ostane webom; cookie by sa s Chrome zdieľala). %>
<%- include('app-lang') %>
<script>
(function () {
  try {
    var d = document.documentElement, s = window.sessionStorage;
    if (/[?&](source|src)=(twa|pwa|app)\b/.test(location.search)) s.setItem('tifo-app', '1');
    var app = s.getItem('tifo-app') === '1'
      || (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches)
      || window.navigator.standalone === true
      || document.referrer.indexOf('android-app://') === 0;
    if (!app) return;
    s.setItem('tifo-app', '1');
    d.classList.add('is-app');
    var lang = window.tifoLang();
    // plynulé prechody medzi stránkami ako na obrazovkách appky (obe strany
    // prechodu ho musia mať zapnutý, inak ho prehliadač zruší s chybou)
    var vt = document.createElement('style');
    vt.textContent = '@view-transition { navigation: auto; }';
    document.head.appendChild(vt);
    if (lang === 'en') d.lang = 'en';
    // webová úvodka a „Centrum" majú v appke vlastnú obrazovku
    var p = location.pathname;
    if (p === '/' || p === '/my') location.replace('/app');
    // pozvánka do ligy (tifo.sk/join?code=…) sa v appke otvorí na obrazovke Ligy
    else if (p === '/join') location.replace('/app/pridat' + location.search);
  } catch (e) { /* bez sessionStorage ostáva web */ }
})();
</script>
