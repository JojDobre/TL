<%- include('_head') %>
<header class="a-top">
  <a class="a-ib" href="javascript:history.length>1?history.back():location.href='/app/home'" aria-label="<%= t('common.back') %>"><svg class="i"><use href="#i-back"/></svg></a>
  <h1><%= t('title.add') %></h1>
</header>
<main class="a-wrap a-in" data-tabs-scope>
  <div class="a-seg" data-tabs>
    <a href="#pridat" data-tab="pridat" class="<%= tab === 'pridat' ? 'on' : '' %>"><%= t('join.tabJoin') %></a>
    <a href="#vytvorit" data-tab="vytvorit" class="<%= tab === 'vytvorit' ? 'on' : '' %>"><%= t('join.tabCreate') %></a>
  </div>

  <!-- PRIDAŤ SA -->
  <section data-pane="pridat"<%= tab === 'pridat' ? '' : ' hidden' %>>
    <form class="a-card a-form" id="joinForm" autocomplete="off" novalidate>
      <label class="a-label" for="joinCode"><%= t('join.codeLabel') %></label>
      <input class="a-code" id="joinCode" name="code" value="<%= code %>" maxlength="12" placeholder="29E384" autocapitalize="characters" autocorrect="off" spellcheck="false" enterkeyhint="go" inputmode="text">
      <div class="a-hint"><%= t('join.codeHint') %></div>
      <div id="joinPwBox" hidden>
        <label class="a-label" for="joinPw" style="margin-top:14px"><%= t('join.pwLabel') %></label>
        <input class="a-input" id="joinPw" type="password" name="password" placeholder="<%= t('join.pwPh') %>" autocomplete="off" enterkeyhint="go">
      </div>
      <div class="a-err" id="joinErr" hidden></div>
      <button class="a-btn gold" type="submit" id="joinBtn" style="margin-top:14px"><%= t('join.submit') %></button>
    </form>

    <div class="a-sec"><%= t('join.official') %></div>
    <% if (!official.length) { %>
      <div class="a-card a-empty" style="padding:26px 18px"><%= t('join.noneOfficial') %></div>
    <% } else { %>
    <div class="a-muted a-small" style="margin:-6px 2px 10px"><%= t('join.officialTx') %></div>
    <div class="a-card a-list">
      <% official.forEach(function (l) { %>
      <div class="a-row">
        <%- include('_crest', { c: l }) %>
        <div style="flex:1;min-width:0">
          <div style="font-weight:700;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= l.name %></div>
          <div class="a-muted a-small"><%= l.players %> <%= tn(l.players, 'player') %><% if (l.auto) { %> · <%= t('liga.auto') %><% } %></div>
        </div>
        <% if (l.member) { %>
          <a class="a-pill ok" href="/app/liga/<%= l.id %>"><%= t('join.member') %></a>
        <% } else { %>
          <button type="button" class="a-mini" data-join-league="<%= l.id %>"><%= t('join.btn') %></button>
        <% } %>
      </div>
      <% }); %>
    </div>
    <% } %>
  </section>

  <!-- VYTVORIŤ LIGU -->
  <section data-pane="vytvorit"<%= tab === 'vytvorit' ? '' : ' hidden' %>>
    <div id="createBox">
    <% if (!allow.ok) { %>
      <div class="a-card a-empty" style="padding:26px 18px"><b><%= t('join.tabCreate') %></b><%= t('join.err.limit', { n: allow.limit }) %></div>
    <% } else { %>
    <form class="a-card a-form" id="createForm" autocomplete="off" novalidate>
      <label class="a-label" for="lgName"><%= t('create.name') %></label>
      <input class="a-input" id="lgName" name="name" maxlength="<%= nameMax %>" placeholder="<%= t('create.namePh') %>" enterkeyhint="done">

      <div class="a-label" style="margin-top:18px"><%= t('create.matches') %></div>
      <div class="a-choice" id="srcChoice">
        <button type="button" data-src="tpl" class="<%= templates.length ? 'on' : '' %>"<%= templates.length ? '' : ' disabled' %>><svg class="i"><use href="#i-trophy"/></svg><b><%= t('create.fromTpl') %></b><span><%= t('create.fromTplTx') %></span></button>
        <button type="button" data-src="own" class="<%= templates.length ? '' : 'on' %>"><svg class="i"><use href="#i-cal"/></svg><b><%= t('create.own') %></b><span><%= t('create.ownTx') %></span></button>
      </div>

      <div id="tplBox"<%= templates.length ? '' : ' hidden' %>>
        <div class="a-label" style="margin-top:18px"><%= t('create.pickTpl') %></div>
        <div class="a-tpls">
          <% templates.forEach(function (tp, i) { %>
          <label class="a-tpl">
            <input type="radio" name="templateId" value="<%= tp.id %>"<%= i === 0 ? ' checked' : '' %>>
            <%- include('_crest', { c: tp }) %>
            <span class="nm"><%= tp.name %></span>
            <span class="rd"></span>
          </label>
          <% }); %>
        </div>
        <div class="a-label" style="margin-top:18px"><%= t('create.tipType') %></div>
        <div class="a-choice two" id="tipChoice">
          <button type="button" data-tip="exact_score" class="on"><b><%= t('create.exact') %></b><span><%= t('create.exactTx') %></span></button>
          <button type="button" data-tip="winner"><b><%= t('create.winner') %></b><span><%= t('create.winnerTx') %></span></button>
        </div>
      </div>

      <label class="a-label" for="lgPw" style="margin-top:18px;display:block"><%= t('create.pw') %></label>
      <input class="a-input" id="lgPw" type="password" name="password" autocomplete="new-password" maxlength="100">
      <div class="a-hint"><%= t('create.pwTx') %></div>
      <div class="a-err" id="createErr" hidden></div>
      <button class="a-btn gold" type="submit" id="createBtn" style="margin-top:16px"><%= t('create.submit') %></button>
    </form>
    <% } %>
    </div>

    <!-- hotovo: kód + pozvanie -->
    <div class="a-card a-done" id="createDone" hidden>
      <div class="ok"><svg class="i"><use href="#i-check"/></svg></div>
      <h2><%= t('create.doneTitle') %></h2>
      <p class="a-muted"><%= t('create.doneTx') %></p>
      <div class="a-label" style="margin-top:18px"><%= t('create.code') %></div>
      <button type="button" class="a-codebox" id="doneCode" aria-label="<%= t('create.copy') %>"></button>
      <button type="button" class="a-btn gold" id="doneShare" style="margin-top:14px"><svg class="i" width="18" height="18"><use href="#i-share"/></svg><%= t('create.share') %></button>
      <a class="a-btn ghost" id="doneOpen" style="margin-top:10px" href="#"><%= t('create.open') %></a>
      <a class="a-btn ghost" id="doneRound" style="margin-top:10px" href="#" hidden><%= t('create.firstRound') %></a>
    </div>
  </section>
</main>
<script>
window.TIFO_ADD = <%- JSON.stringify({
  joined: t('join.joined'), joinedSeason: t('join.joinedSeason'), copied: t('create.copied'),
  shareText: t('create.shareText'), err: t('join.err.failed'),
}).replace(/</g, '\\u003c') %>;
</script>
<%- include('_foot') %>
