<%- include('_head') %>
<header class="a-top"><h1><%= t('title.ranks') %></h1></header>
<main class="a-wrap a-in">
  <div class="a-seg"><a class="on" href="/app/rebricky"><%= t('rbs.mine') %></a><a href="/app/rebricky/celkovo"><%= t('rbs.global') %></a></div>

  <% if (!active.length && !ended.length) { %>
    <div class="a-card a-empty" style="margin-top:14px"><b><%= t('rbs.none') %></b><%= t('rbs.noneTx') %><div style="margin-top:14px"><a class="a-btn gold" href="/seasons"><%= t('home.browse') %></a></div></div>
  <% } %>

  <% active.forEach(function (l) { %>
  <a class="a-lg a-press" href="/app/rebricky/<%= l.id %>" style="background:radial-gradient(120% 100% at 100% 0%,<%= l.grad.replace('linear-gradient(135deg,', '').split(',')[0] %>55,transparent 60%),var(--a-s1)">
    <div class="hd"><%- include('_crest', { c: l }) %><div style="flex:1;min-width:0"><div class="nm" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= l.name %></div><div class="a-muted a-small"><%= l.players %> <%= tn(l.players, 'player') %><% if (l.roundsTotal) { %> · <%= t('liga.roundOf', { a: Math.min(l.roundsPlayed + 1, l.roundsTotal), b: l.roundsTotal }) %><% } %></div></div><svg class="i a-muted" width="18" height="18"><use href="#i-chev"/></svg></div>
    <div class="ft">
      <div>
        <div><span class="rk" style="<%= l.rank && l.rank <= 3 ? 'color:var(--a-gold)' : '' %>"><%= l.rank ? l.rank + '.' : '–' %></span><% if (l.move) { %><span class="mv <%= l.move > 0 ? 'a-up' : 'a-down' %>"><%= l.move > 0 ? '+' : '−' %><%= Math.abs(l.move) %></span><% } %></div>
        <div class="a-muted a-small" style="margin-top:4px"><%= l.points %> <%= tn(l.points, 'point') %><% if (l.rank === 1) { %> · <%= t('rbs.leading') %><% } else if (l.rank && l.gapToLeader) { %> · <%= t('rbs.gap', { n: l.gapToLeader }) %><% } %><% if (l.topPct && l.ranked >= 20) { %> · <%= t('rbs.top', { n: l.topPct }) %><% } %></div>
      </div>
      <% if (l.hasPrizes) { %><span class="a-pill gold"><%= t('rbs.prizes') %></span>
      <% } else if (l.top3.length) { %><div class="a-stack"><% l.top3.forEach(function (u) { %><%- include('_av', { u: u, size: 30 }) %><% }); %></div><% } %>
    </div>
    <% if (l.spark) { %>
    <svg viewBox="0 0 300 40" style="width:100%;height:40px;margin-top:10px;fill:none;stroke:#9d83ff;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round"><path d="<%= l.spark %>"/></svg>
    <div class="a-muted" style="font-size:11px;display:flex;justify-content:space-between"><span><%= t('rbs.hist', { n: l.histLen }) %></span><% if (l.bestRank) { %><span style="color:var(--a-brand-b);font-weight:700"><%= t('rbs.best', { n: l.bestRank }) %></span><% } %></div>
    <% } %>
  </a>
  <% }); %>

  <% if (ended.length) { %>
  <div class="a-sec"><%= t('rbs.ended') %></div>
  <% ended.forEach(function (l) { %>
  <a class="a-lg compact a-press" href="/app/rebricky/<%= l.id %>"><%- include('_crest', { c: l }) %><div style="flex:1;min-width:0"><div class="nm" style="font-size:15px"><%= l.name %></div><div class="a-muted a-small"><%= t('rbs.endedOne') %> · <%= l.players %> <%= tn(l.players, 'player') %></div></div><div class="a-num" style="font-size:18px"><%= l.rank ? l.rank + '.' : '–' %></div></a>
  <% }); %>
  <% } %>
</main>
<%- include('_foot') %>
