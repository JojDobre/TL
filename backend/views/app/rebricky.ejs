<%- include('_head') %>
<header class="a-top"><h1>Rebríčky</h1></header>
<main class="a-wrap a-in">
  <div class="a-seg"><a class="on" href="/app/rebricky">Moje ligy</a><a href="/app/rebricky/celkovo">Celkový rebríček</a></div>

  <% if (!active.length && !ended.length) { %>
    <div class="a-card a-empty" style="margin-top:14px"><b>Zatiaľ žiadne ligy</b>Keď sa pridáš do ligy, uvidíš tu svoje poradie.<div style="margin-top:14px"><a class="a-btn gold" href="/seasons">Prehľadať súťaže</a></div></div>
  <% } %>

  <% active.forEach(function (l) { %>
  <a class="a-lg a-press" href="/app/rebricky/<%= l.id %>" style="background:radial-gradient(120% 100% at 100% 0%,<%= l.grad.replace('linear-gradient(135deg,', '').split(',')[0] %>55,transparent 60%),var(--a-s1)">
    <div class="hd"><%- include('_crest', { c: l }) %><div style="flex:1;min-width:0"><div class="nm" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= l.name %></div><div class="a-muted a-small"><%= l.players %> <%= pl(l.players, 'hráč', 'hráči', 'hráčov') %><% if (l.roundsTotal) { %> · kolo <%= Math.min(l.roundsPlayed + 1, l.roundsTotal) %> z <%= l.roundsTotal %><% } %></div></div><svg class="i a-muted" width="18" height="18"><use href="#i-chev"/></svg></div>
    <div class="ft">
      <div>
        <div><span class="rk" style="<%= l.rank && l.rank <= 3 ? 'color:var(--a-gold)' : '' %>"><%= l.rank ? l.rank + '.' : '–' %></span><% if (l.move) { %><span class="mv <%= l.move > 0 ? 'a-up' : 'a-down' %>"><%= l.move > 0 ? '+' : '−' %><%= Math.abs(l.move) %></span><% } %></div>
        <div class="a-muted a-small" style="margin-top:4px"><%= l.points %> <%= pl(l.points, 'bod', 'body', 'bodov') %><% if (l.rank === 1) { %> · vedieš<% } else if (l.rank && l.gapToLeader) { %> · <%= l.gapToLeader %> b za lídrom<% } %><% if (l.topPct && l.ranked >= 20) { %> · top <%= l.topPct %> %<% } %></div>
      </div>
      <% if (l.hasPrizes) { %><span class="a-pill gold">Ceny v lige</span>
      <% } else if (l.top3.length) { %><div class="a-stack"><% l.top3.forEach(function (u) { %><%- include('_av', { u: u, size: 30 }) %><% }); %></div><% } %>
    </div>
    <% if (l.spark) { %>
    <svg viewBox="0 0 300 40" style="width:100%;height:40px;margin-top:10px;fill:none;stroke:#9d83ff;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round"><path d="<%= l.spark %>"/></svg>
    <div class="a-muted" style="font-size:11px;display:flex;justify-content:space-between"><span>poradie za posledných <%= l.histLen %> kôl</span><% if (l.bestRank) { %><span style="color:var(--a-brand-b);font-weight:700">najlepšie <%= l.bestRank %>.</span><% } %></div>
    <% } %>
  </a>
  <% }); %>

  <% if (ended.length) { %>
  <div class="a-sec">Ukončené</div>
  <% ended.forEach(function (l) { %>
  <a class="a-lg compact a-press" href="/app/rebricky/<%= l.id %>"><%- include('_crest', { c: l }) %><div style="flex:1;min-width:0"><div class="nm" style="font-size:15px"><%= l.name %></div><div class="a-muted a-small">Ukončená · <%= l.players %> <%= pl(l.players, 'hráč', 'hráči', 'hráčov') %></div></div><div class="a-num" style="font-size:18px"><%= l.rank ? l.rank + '.' : '–' %></div></a>
  <% }); %>
  <% } %>
</main>
<%- include('_foot') %>
