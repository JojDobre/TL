<%- include('_head') %>
<div style="position:absolute;left:0;right:0;top:0;height:280px;background:radial-gradient(100% 90% at 50% 0%,<%= league.grad.replace('linear-gradient(135deg,', '').split(',')[0] %>88,transparent 70%);z-index:0"></div>
<header class="a-top">
  <a class="a-ib" href="javascript:history.length>1?history.back():location.href='/app/home'" aria-label="<%= t('common.back') %>"><svg class="i"><use href="#i-back"/></svg></a>
  <div style="flex:1"></div>
  <% if (!league.locked) { %><button class="a-ib" type="button" data-liga-menu aria-label="<%= t('liga.menu') %>"><svg class="i"><use href="#i-list"/></svg></button><% } %>
</header>
<main class="a-wrap a-in" data-tabs-scope>
  <div class="a-hero">
    <%- include('_crest', { c: league }) %>
    <h2><%= league.name %></h2>
    <div class="a-muted a-small" style="margin-top:3px"><%= t(league.isOfficial ? 'liga.official' : 'liga.community') %> · <%= membersCount %> <%= tn(membersCount, 'player') %><% if (roundsTotal) { %> · <%= t('liga.roundOf', { a: Math.min(roundsPlayed + 1, roundsTotal), b: roundsTotal }) %><% } %></div>
    <div style="display:flex;gap:6px;margin-top:10px;flex-wrap:wrap;justify-content:center">
      <% if (league.ended) { %><span class="a-pill warn"><%= t('liga.ended') %></span>
      <% } else if (hasOpen) { %><span class="a-pill ok"><span style="width:6px;height:6px;border-radius:50%;background:currentColor"></span><%= t('liga.open') %></span><% } %>
      <% if (league.auto) { %><span class="a-pill info"><%= t('liga.auto') %></span><% } %>
      <% if (myRank) { %><span class="a-pill gold"><%= t('liga.youAre', { r: myRank, p: myPoints }) %></span><% } %>
    </div>
    <% if (league.description) { %><p class="a-muted a-small" style="margin:10px auto 0;max-width:420px;text-align:center;line-height:1.5"><%= league.description %></p><% } %>
  </div>

  <% if (league.locked) { %>
  <form class="a-card" style="margin-top:18px;padding:18px" data-liga-join data-code="">
    <div style="display:flex;gap:12px;align-items:center;margin-bottom:14px"><div class="a-ico" style="width:40px;height:40px;border-radius:13px;background:var(--a-s2);color:var(--a-t2)"><svg class="i"><use href="#i-users"/></svg></div><div><b><%= t('liga.locked') %></b><div class="a-muted a-small"><%= t('liga.lockedTx') %></div></div></div>
    <input type="hidden" name="leagueId" value="<%= league.id %>">
    <input class="a-input" type="password" name="password" placeholder="<%= t('liga.password') %>" autocomplete="off" required>
    <div class="a-err" data-join-err hidden></div>
    <button class="a-btn gold" type="submit" style="margin-top:12px"><%= t('liga.join') %></button>
  </form>
  <% } else { %>
  <% if (!league.member && !league.ended) { %>
  <button class="a-btn gold" type="button" style="margin-top:16px" data-liga-join-now data-code="<%= league.joinCode %>"><%= t('liga.join') %></button>
  <% } %>

  <div class="a-seg" data-tabs style="margin-top:18px">
    <a href="#kola" data-tab="kola" class="on"><%= t('liga.rounds') %></a>
    <a href="#rebricek" data-tab="rebricek"><%= t('liga.board') %></a>
    <% if (prizes.length) { %><a href="#ceny" data-tab="ceny"><%= t('liga.prizes') %></a><% } %>
    <a href="#pravidla" data-tab="pravidla"><%= t('liga.rules') %></a>
  </div>

  <section class="a-pane" data-pane="kola" style="margin-top:14px">
    <% if (noTeams) { %><div class="a-note" style="margin:0 0 12px"><svg class="i"><use href="#i-info"/></svg><div><b><%= t('liga.noTeams') %></b><br><%= t('liga.noTeamsTx') %></div></div><% } %>
    <% if (canManage && !league.template && !league.ended) { %><a class="a-btn ghost" style="margin-bottom:12px" href="/rounds/create?league=<%= league.id %>"><svg class="i" width="18" height="18"><use href="#i-plus"/></svg><%= t('liga.newRound') %></a><% } %>
    <% if (!rounds.length) { %><div class="a-card a-empty"><b><%= t('liga.noRounds') %></b><%= t('liga.noRoundsTx') %></div><% } %>
    <% if (rounds.length) { %>
    <div class="a-card a-list">
      <% rounds.forEach(function (r) { %>
      <a class="a-row" href="<%= r.status === 'open' && league.member ? '/app/tipovat?kolo=' + r.id : '/rounds/' + r.id %>">
        <div class="a-ico" style="width:36px;height:36px;border-radius:12px;<%= r.status === 'open' ? 'background:var(--a-ok-soft);color:var(--a-ok)' : (r.status === 'scheduled' ? 'background:var(--a-info-soft);color:var(--a-info)' : 'background:var(--a-s2);color:var(--a-t3)') %>"><svg class="i"><use href="#i-<%= r.status === 'open' ? 'ball' : (r.status === 'scheduled' ? 'cal' : 'check') %>"/></svg></div>
        <div style="flex:1;min-width:0"><div style="font-weight:700;font-size:14.5px"><%= r.name %></div><div class="a-muted a-small"><%= r.when %> · <%= r.matches %> <%= tn(r.matches, 'match') %></div></div>
        <% if (r.status === 'open') { %><span class="a-pill <%= r.myTips >= r.matches ? 'ok' : 'warn' %>"><%= r.myTips %>/<%= r.matches %></span><% } else { %><svg class="i a-muted" width="18" height="18"><use href="#i-chev"/></svg><% } %>
      </a>
      <% }); %>
    </div>
    <% } %>
  </section>

  <section class="a-pane" data-pane="rebricek" hidden style="margin-top:14px">
    <% if (!top5.length) { %><div class="a-card a-empty"><b><%= t('liga.noPoints') %></b><%= t('liga.noPointsTx') %></div><% } else { %>
    <div class="a-card" style="padding:2px 0">
      <% top5.forEach(function (r) { %>
      <div class="a-rrow <%= r.me ? 'me' : '' %>"><span class="r" style="<%= r.rank === 1 ? 'color:var(--a-gold)' : '' %>"><%= r.rank %></span><%- include('_av', { u: r, size: 34 }) %><span class="nm"><%= r.me ? t('common.you') : r.name %></span><span class="a-pts"><%= r.points %></span></div>
      <% }); %>
    </div>
    <a class="a-btn ghost" style="margin-top:12px" href="/app/rebricky/<%= league.id %>"><%= t('liga.fullBoard') %></a>
    <% } %>
  </section>

  <% if (prizes.length) { %>
  <section class="a-pane" data-pane="ceny" hidden>
    <div class="a-prize1">
      <svg class="i bg"><use href="#i-trophy"/></svg>
      <div class="a-label" style="color:var(--a-gold)"><%= t('liga.place', { n: prizes[0].place || 1 }) %></div>
      <div style="font:700 19px var(--a-disp);margin-top:6px;position:relative"><%= prizes[0].prize %></div>
    </div>
    <% if (prizes.length > 1) { %>
    <div class="a-prizes">
      <% prizes.slice(1).forEach(function (p, i) { %>
      <div class="a-glass">
        <div class="a-ico" style="width:36px;height:36px;border-radius:12px;<%= i === 0 ? 'background:rgba(184,192,214,.14);color:#cfd5e6' : (i === 1 ? 'background:rgba(176,122,74,.18);color:#d9a273' : 'background:var(--a-s2);color:var(--a-t3)') %>"><svg class="i"><use href="#i-<%= i === 0 ? 'gift' : (i === 1 ? 'ticket' : 'medal') %>"/></svg></div>
        <div class="a-label" style="margin-top:10px"><%= t('liga.place', { n: p.place || (i + 2) }) %></div>
        <div style="font:700 14.5px var(--a-disp);margin-top:3px"><%= p.prize %></div>
      </div>
      <% }); %>
    </div>
    <% } %>
    <div class="a-note"><svg class="i"><use href="#i-info"/></svg><div><%= t('liga.prizeNote') %> <a href="#pravidla" style="color:var(--a-brand-b);font-weight:700" onclick="document.querySelector('[data-tab=pravidla]').click();return false;"><%= t('liga.rules') %></a>.</div></div>
  </section>
  <% } %>

  <section class="a-pane" data-pane="pravidla" hidden style="margin-top:14px">
    <div class="a-sec" style="margin-top:4px"><%= t('liga.scoring') %></div>
    <div class="a-card a-list">
      <div class="a-row"><span style="flex:1"><%= t('liga.exact') %></span><b class="a-num" style="color:var(--a-gold)"><%= scoring.exactScore %> <%= t('common.pts') %></b></div>
      <div class="a-row"><span style="flex:1"><%= t('liga.winner') %></span><b class="a-num"><%= scoring.correctWinner %> <%= t('common.pts') %></b></div>
      <div class="a-row"><span style="flex:1"><%= t('liga.diff') %></span><b class="a-num"><%= scoring.goalDifference %> <%= t('common.pts') %></b></div>
      <div class="a-row"><span style="flex:1"><%= t('liga.goals') %></span><b class="a-num"><%= scoring.correctGoals %> <%= t('common.pts') %></b></div>
    </div>
    <% if (rules) { %>
    <div class="a-sec"><%= t('liga.seasonRules') %></div>
    <div class="a-card a-rules"><%= rules %></div>
    <% } %>
  </section>
  <template id="ligaMenu">
    <h3><%= t('liga.menu') %></h3>
    <div class="a-idrow"><div><div class="a-label"><%= t('liga.code') %></div><b class="a-num"><%= league.joinCode %></b></div><button type="button" class="a-chip" data-copy-code="<%= league.joinCode %>"><%= t('liga.copy') %></button></div>
    <div class="a-card a-list a-menu" style="margin-top:12px">
      <a class="a-row" href="#" data-share-league data-code="<%= league.joinCode %>" data-name="<%= league.name %>"><div class="a-ico" style="background:var(--a-gold-soft);color:var(--a-gold)"><svg class="i"><use href="#i-share"/></svg></div><span class="lbl"><%= t('liga.invite') %></span><svg class="i a-muted" width="18" height="18"><use href="#i-chev"/></svg></a>
      <% if (canManage) { %>
      <a class="a-row" href="/leagues/<%= league.id %>/manage"><div class="a-ico" style="background:var(--a-brand-soft);color:var(--a-brand-b)"><svg class="i"><use href="#i-cog"/></svg></div><span class="lbl"><%= t('liga.manage') %></span><svg class="i a-muted" width="18" height="18"><use href="#i-chev"/></svg></a>
      <% if (!league.template && !league.ended) { %><a class="a-row" href="/rounds/create?league=<%= league.id %>"><div class="a-ico" style="background:var(--a-ok-soft);color:var(--a-ok)"><svg class="i"><use href="#i-plus"/></svg></div><span class="lbl"><%= t('liga.newRound') %></span><svg class="i a-muted" width="18" height="18"><use href="#i-chev"/></svg></a><% } %>
      <a class="a-row" href="/leagues/<%= league.id %>/members"><div class="a-ico" style="background:var(--a-info-soft);color:var(--a-info)"><svg class="i"><use href="#i-users"/></svg></div><span class="lbl"><%= t('liga.members') %></span><svg class="i a-muted" width="18" height="18"><use href="#i-chev"/></svg></a>
      <% } %>
      <a class="a-row" href="/seasons/<%= league.seasonId %>"><div class="a-ico" style="background:var(--a-s2);color:var(--a-t2)"><svg class="i"><use href="#i-trophy"/></svg></div><span class="lbl"><%= t('liga.season') %></span><svg class="i a-muted" width="18" height="18"><use href="#i-chev"/></svg></a>
    </div>
    <% if (league.member && !league.creator) { %>
    <form class="a-card a-list a-menu" style="margin-top:10px" action="/leagues/<%= league.id %>/leave" method="POST" data-confirm="<%= t('liga.leaveQ') %>">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <button class="a-row" type="submit" style="width:100%"><div class="a-ico" style="background:rgba(240,71,106,.12);color:var(--a-bad)"><svg class="i"><use href="#i-logout"/></svg></div><span class="lbl" style="color:var(--a-bad)"><%= t('liga.leave') %></span></button>
    </form>
    <% } %>
  </template>
  <% } %>
</main>
<script>window.TIFO_LIGA = <%- JSON.stringify({ copied: t('create.copied'), shareText: t('create.shareText'), joined: t('join.joined') }).replace(/</g, '\\u003c') %>;</script>
<%- include('_foot') %>
