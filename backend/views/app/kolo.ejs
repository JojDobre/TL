<%- include('_head') %>
<script>document.body.setAttribute('data-total', '<%= open.length %>');</script>
<header class="a-top">
  <a class="a-ib" href="javascript:history.length>1?history.back():location.href='/app/liga/<%= league.id %>'" aria-label="<%= t('common.back') %>"><svg class="i"><use href="#i-back"/></svg></a>
  <div style="flex:1"></div>
</header>
<main class="a-wrap a-in" data-tabs-scope>
  <section class="a-banner" style="--bn:<%= league.grad %>" data-wm="<%= league.initials %>">
    <div class="bn-top">
      <a href="/app/liga/<%= league.id %>"><%- include('_crest', { c: league }) %></a>
      <div style="min-width:0">
        <a class="bn-eyebrow" href="/app/liga/<%= league.id %>"><%= league.name %></a>
        <h1 class="bn-title"><%= round.name %></h1>
      </div>
    </div>
    <% if (round.description) { %><p class="bn-desc"><%= round.description %></p><% } %>
    <div class="bn-pills">
      <% if (round.status === 'open') { %><span class="bn-pill"><span class="dot"></span><%= t('kolo.st.open') %> · <%= t('round.deadline', { x: round.deadline }) %></span>
      <% } else if (round.status === 'scheduled') { %><span class="bn-pill"><%= t('round.opens', { x: round.opens }) %></span>
      <% } else { %><span class="bn-pill"><%= t('kolo.st.finished') %></span><% } %>
      <% if (myRank) { %><span class="bn-pill gold"><%= t('kolo.rank', { r: myRank }) %></span><% } %>
    </div>
    <div class="bn-stats">
      <div><b><%= total %></b><span><%= tn(total, 'match') %></span></div>
      <div><b data-kolo-count><%= open.length ? tippedOpen + '/' + open.length : '–' %></b><span><%= t('kolo.toTip').toLowerCase() %></span></div>
      <div><b><%= myPoints %></b><span><%= t('prof.points') %></span></div>
    </div>
    <div class="bn-actions">
      <% if (open.length) { %><button class="a-btn gold" type="button" data-kolo-go><svg class="i" width="18" height="18"><use href="#i-ball"/></svg><%= t('noti.tip') %></button>
      <% } else if (share) { %><button class="a-btn gold" type="button" data-share-card="<%= JSON.stringify(share) %>"><svg class="i" width="18" height="18"><use href="#i-share"/></svg><%= t('share.btn') %></button>
      <% } else { %><button class="a-btn ghost" type="button" onclick="document.querySelector('[data-tab=rebricek]').click()"><%= t('kolo.board') %></button><% } %>
      <% if (open.length && share) { %><button class="bn-ib" type="button" data-share-card="<%= JSON.stringify(share) %>" aria-label="<%= t('share.btn') %>"><svg class="i"><use href="#i-share"/></svg></button><% } %>
      <a class="bn-ib" href="/app/liga/<%= league.id %>" aria-label="<%= t('kolo.openLeague') %>"><svg class="i"><use href="#i-trophy"/></svg></a>
      <button class="bn-ib" type="button" data-kolo-menu aria-label="<%= t('kolo.menu') %>"><svg class="i"><use href="#i-list"/></svg></button>
    </div>
  </section>

  <div class="a-seg" data-tabs style="margin-top:18px">
    <a href="#zapasy" data-tab="zapasy" class="on"><%= t('kolo.matches') %></a>
    <a href="#rebricek" data-tab="rebricek"><%= t('kolo.board') %></a>
    <a href="#bodovanie" data-tab="bodovanie"><%= t('kolo.scoring') %></a>
  </div>

  <section class="a-pane" data-pane="zapasy" style="margin-top:14px">
    <% if (!total) { %><div class="a-card a-empty"><b><%= t('kolo.empty') %></b></div><% } %>
    <% if (round.status === 'open' && !league.member) { %>
    <div class="a-note" style="margin:0 0 12px"><svg class="i"><use href="#i-info"/></svg><div><%= t('kolo.notMember') %> <a href="/app/liga/<%= league.id %>" style="color:var(--a-brand-b);font-weight:700"><%= t('liga.join') %></a></div></div>
    <% } else if (round.status === 'scheduled') { %>
    <div class="a-note" style="margin:0 0 12px"><svg class="i"><use href="#i-cal"/></svg><div><%= t('kolo.opensAt', { x: round.opens }) %></div></div>
    <% } %>

    <% if (open.length) { %>
    <div class="a-sec" style="margin-top:4px" id="naTip"><span><%= t('kolo.toTip') %></span></div>
    <% open.forEach(function (m) { %><%- include('_match', { m: m, meta: '' }) %><% }); %>
    <div class="a-muted a-small" style="text-align:center;margin:10px 0 4px"><%= t('kolo.canChange') %></div>
    <% } %>

    <% if (done.length) { %>
    <% if (open.length) { %><div class="a-sec"><%= t('kolo.rest') %></div><% } %>
    <% done.forEach(function (m) { %><%- include('_result', { m: m }) %><% }); %>
    <% } %>
  </section>

  <section class="a-pane" data-pane="rebricek" hidden style="margin-top:14px">
    <% if (!board.length) { %><div class="a-card a-empty"><b><%= t('liga.noPoints') %></b><%= t('kolo.noBoard') %></div><% } else { %>
    <div class="a-card" style="padding:2px 0">
      <% board.forEach(function (r) { %>
      <div class="a-rrow <%= r.me ? 'me' : '' %>"><span class="r" style="<%= r.rank === 1 ? 'color:var(--a-gold)' : '' %>"><%= r.rank %></span><%- include('_av', { u: r, size: 34 }) %><span class="nm"><%= r.me ? t('common.you') : r.name %></span><span class="a-pts"><%= r.points %></span></div>
      <% }); %>
      <% if (meRow) { %><div class="a-rrow me"><span class="r"><%= meRow.rank %></span><%- include('_av', { u: meRow, size: 34 }) %><span class="nm"><%= t('common.you') %></span><span class="a-pts"><%= meRow.points %></span></div><% } %>
    </div>
    <% } %>
    <a class="a-btn ghost" style="margin-top:12px" href="/app/rebricky/<%= league.id %>"><%= t('liga.fullBoard') %></a>
  </section>

  <section class="a-pane" data-pane="bodovanie" hidden style="margin-top:14px">
    <div class="a-card a-list">
      <div class="a-row"><span style="flex:1"><%= t('liga.exact') %></span><b class="a-num" style="color:var(--a-gold)"><%= scoring.exactScore %> <%= t('common.pts') %></b></div>
      <div class="a-row"><span style="flex:1"><%= t('liga.winner') %></span><b class="a-num"><%= scoring.correctWinner %> <%= t('common.pts') %></b></div>
      <div class="a-row"><span style="flex:1"><%= t('liga.diff') %></span><b class="a-num"><%= scoring.goalDifference %> <%= t('common.pts') %></b></div>
      <div class="a-row"><span style="flex:1"><%= t('liga.goals') %></span><b class="a-num"><%= scoring.correctGoals %> <%= t('common.pts') %></b></div>
      <% if (jokerOn) { %><div class="a-row"><span style="flex:1">🃏 <%= t('joker.rule') %></span><b class="a-num" style="color:var(--a-gold)">2×</b></div><% } %>
    </div>
  </section>

  <template id="koloMenu">
    <h3><%= t('kolo.menu') %></h3>
    <div class="a-card a-list a-menu" style="margin-top:12px">
      <a class="a-row" href="/app/liga/<%= league.id %>"><div class="a-ico" style="background:var(--a-brand-soft);color:var(--a-brand-b)"><svg class="i"><use href="#i-trophy"/></svg></div><span class="lbl"><%= t('kolo.openLeague') %></span><svg class="i a-muted" width="18" height="18"><use href="#i-chev"/></svg></a>
      <% if (league.member && round.status !== 'finished' && !league.locked) { %><a class="a-row" href="/app/suboj/novy?kolo=<%= round.id %>"><div class="a-ico" style="background:rgba(240,71,106,.14);color:#ff6b88"><svg class="i"><use href="#i-duel"/></svg></div><span class="lbl"><%= t('duel.menu') %></span><svg class="i a-muted" width="18" height="18"><use href="#i-chev"/></svg></a><% } %>
      <a class="a-row" href="/app/suboje"><div class="a-ico" style="background:var(--a-s2);color:var(--a-t2)"><svg class="i"><use href="#i-list"/></svg></div><span class="lbl"><%= t('duel.my') %></span><svg class="i a-muted" width="18" height="18"><use href="#i-chev"/></svg></a>
      <% if (canEdit) { %>
      <a class="a-row" href="/rounds/<%= round.id %>/evaluate"><div class="a-ico" style="background:var(--a-gold-soft);color:var(--a-gold)"><svg class="i"><use href="#i-checks"/></svg></div><span class="lbl"><%= t('kolo.evaluate') %></span><svg class="i a-muted" width="18" height="18"><use href="#i-chev"/></svg></a>
      <a class="a-row" href="/rounds/<%= round.id %>/matches/create"><div class="a-ico" style="background:var(--a-ok-soft);color:var(--a-ok)"><svg class="i"><use href="#i-plus"/></svg></div><span class="lbl"><%= t('kolo.addMatches') %></span><svg class="i a-muted" width="18" height="18"><use href="#i-chev"/></svg></a>
      <a class="a-row" href="/rounds/<%= round.id %>/edit"><div class="a-ico" style="background:var(--a-info-soft);color:var(--a-info)"><svg class="i"><use href="#i-cog"/></svg></div><span class="lbl"><%= t('kolo.edit') %></span><svg class="i a-muted" width="18" height="18"><use href="#i-chev"/></svg></a>
      <% } %>
    </div>
    <% if (canEdit) { %>
    <div class="a-card a-list a-menu" style="margin-top:10px">
      <button class="a-row" type="button" style="width:100%" data-del-round="<%= round.id %>" data-league="<%= league.id %>" data-q="<%= t('kolo.deleteQ') %>"><div class="a-ico" style="background:rgba(240,71,106,.12);color:var(--a-bad)"><svg class="i"><use href="#i-x"/></svg></div><span class="lbl" style="color:var(--a-bad)"><%= t('kolo.delete') %></span></button>
    </div>
    <% } %>
  </template>
</main>
<script src="/js/share-card.js?v=<%= assetV %>" defer></script>
<%- include('_foot') %>
