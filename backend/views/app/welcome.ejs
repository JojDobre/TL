<%- include('_head') %>
<script>try { if (localStorage.getItem('tifo-onboarded')) location.replace('/login'); } catch (e) {}</script>
<div class="a-onb">
  <div class="skip"><a href="/login" data-onb-skip>Preskočiť</a></div>
  <div class="slides">
    <section class="slide">
      <div class="art"><img src="/branding/identity/tifo-mascot-512.webp" alt="Maskot Tifo"></div>
      <div class="step">KROK 1 Z 3</div>
      <h2>Tipuj výsledky<br>svojich zápasov</h2>
      <p>Pridaj sa do ligy s kamarátmi alebo do oficiálnej súťaže. Tip zmeníš kedykoľvek až do výkopu.</p>
    </section>
    <section class="slide">
      <div class="art"><svg class="i"><use href="#i-trophy"/></svg></div>
      <div class="step">KROK 2 Z 3</div>
      <h2>Zbieraj body<br>a stúpaj v rebríčku</h2>
      <div class="a-pts-list">
        <div><span>Presný výsledok</span><b>10 b</b></div>
        <div><span>Správny víťaz alebo remíza</span><b>3 b</b></div>
        <div><span>Gólový rozdiel</span><b>2 b</b></div>
      </div>
    </section>
    <section class="slide">
      <div class="art"><svg class="i"><use href="#i-bell"/></svg></div>
      <div class="step">KROK 3 Z 3</div>
      <h2>Nezmeškaj<br>žiadnu uzávierku</h2>
      <p>Pripomenieme ti netipnuté zápasy a dáme vedieť, keď dostaneš body. Výsledky sa vyhodnocujú automaticky.</p>
    </section>
  </div>
  <div class="dots"><i class="on"></i><i></i><i></i></div>
  <div class="foot">
    <button class="a-btn gold" type="button" data-onb-next data-done="/register">Pokračovať</button>
    <div class="alt">Už máš účet? <a href="/login" data-onb-skip>Prihlásiť sa</a></div>
  </div>
</div>
<%- include('_foot') %>
