<%- include('_head') %>
<script>try { if (localStorage.getItem('tifo-onboarded')) location.replace('/login'); } catch (e) {}</script>
<div class="a-onb">
  <div class="skip"><a href="/login" data-onb-skip><%= t('onb.skip') %></a></div>
  <div class="slides">
    <section class="slide">
      <div class="art"><img src="/branding/identity/tifo-mascot-512.webp" alt="<%= t('onb.mascot') %>"></div>
      <div class="step"><%= t('onb.step', { n: 1 }) %></div>
      <h2><%- t('onb.h1') %></h2>
      <p><%= t('onb.p1') %></p>
    </section>
    <section class="slide">
      <div class="art"><svg class="i"><use href="#i-trophy"/></svg></div>
      <div class="step"><%= t('onb.step', { n: 2 }) %></div>
      <h2><%- t('onb.h2') %></h2>
      <div class="a-pts-list">
        <div><span><%= t('onb.exact') %></span><b>10 <%= t('common.pts') %></b></div>
        <div><span><%= t('onb.winner') %></span><b>3 <%= t('common.pts') %></b></div>
        <div><span><%= t('onb.diff') %></span><b>2 <%= t('common.pts') %></b></div>
      </div>
    </section>
    <section class="slide">
      <div class="art"><svg class="i"><use href="#i-bell"/></svg></div>
      <div class="step"><%= t('onb.step', { n: 3 }) %></div>
      <h2><%- t('onb.h3') %></h2>
      <p><%= t('onb.p3') %></p>
    </section>
  </div>
  <div class="dots"><i class="on"></i><i></i><i></i></div>
  <div class="foot">
    <button class="a-btn gold" type="button" data-onb-next data-done="/register"><%= t('onb.continue') %></button>
    <div class="alt"><%= t('onb.have') %> <a href="/login" data-onb-skip><%= t('onb.login') %></a></div>
  </div>
</div>
<%- include('_foot') %>
