<%- include('_head') %>
<div style="position:absolute;left:0;right:0;top:0;height:260px;background:radial-gradient(110% 90% at 50% 0%,rgba(124,92,255,.5),transparent 70%);z-index:0"></div>
<header class="a-top"><div style="flex:1"></div><a class="a-ib" href="/settings" aria-label="Nastavenia"><svg class="i"><use href="#i-cog"/></svg></a></header>
<main class="a-wrap a-in">
  <div class="a-hero">
    <%- include('_av', { u: { image: me.image, initials: me.initials, color: 'linear-gradient(135deg,#7c5cff,#3b1f8f)' }, size: 84, st: 'font-size:26px;box-shadow:0 0 0 4px #080b14,0 0 0 6px #9d83ff,0 14px 34px rgba(124,92,255,.45)' }) %>
    <h2><%= me.name %></h2>
    <div class="a-muted a-small">@<%= me.username %> · člen od <%= me.since %></div>
  </div>
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:16px">
    <div class="a-glass" style="padding:12px;text-align:center"><div class="a-num" style="font-size:22px"><%= stats.points %></div><div class="a-muted" style="font-size:11.5px;font-weight:600">bodov</div></div>
    <div class="a-glass" style="padding:12px;text-align:center"><div class="a-num" style="font-size:22px;color:var(--a-ok)"><%= stats.accuracy != null ? stats.accuracy + ' %' : '–' %></div><div class="a-muted" style="font-size:11.5px;font-weight:600">presnosť</div></div>
    <div class="a-glass" style="padding:12px;text-align:center"><div class="a-num" style="font-size:22px;color:var(--a-gold)"><%= stats.exact %></div><div class="a-muted" style="font-size:11.5px;font-weight:600">presných</div></div>
  </div>

  <div class="a-sec">Odznaky <a href="/achievements"><%= earnedCount %> z <%= totalBadges %></a></div>
  <a class="a-badges" href="/achievements">
    <% badges.forEach(function (b) { %><div class="a-badge" title="<%= b.name %>" style="background:linear-gradient(135deg,<%= b.style.bg %>,rgba(255,255,255,.02));border:1px solid <%= b.style.line %>;color:<%= b.style.fg %>"><svg class="i"><use href="#i-<%= b.icon %>"/></svg></div><% }); %>
    <% for (let i = 0; i < placeholders; i++) { %><div class="a-badge off"><svg class="i"><use href="#i-<%= ['trophy', 'medal', 'star', 'flame', 'target'][i % 5] %>"/></svg></div><% } %>
  </a>

  <div class="a-card a-list a-menu" style="margin-top:18px">
    <a class="a-row" href="/seasons"><div class="a-ico" style="background:var(--a-brand-soft);color:var(--a-brand-b)"><svg class="i"><use href="#i-trophy"/></svg></div><span class="lbl">Sezóny a súťaže</span><svg class="i a-muted" width="18" height="18"><use href="#i-chev"/></svg></a>
    <a class="a-row" href="/tip-history"><div class="a-ico" style="background:var(--a-info-soft);color:var(--a-info)"><svg class="i"><use href="#i-hist"/></svg></div><span class="lbl">História tipov</span><svg class="i a-muted" width="18" height="18"><use href="#i-chev"/></svg></a>
    <a class="a-row" href="/stats"><div class="a-ico" style="background:var(--a-ok-soft);color:var(--a-ok)"><svg class="i"><use href="#i-bars"/></svg></div><span class="lbl">Štatistiky</span><svg class="i a-muted" width="18" height="18"><use href="#i-chev"/></svg></a>
    <a class="a-row" href="/blog"><div class="a-ico" style="background:var(--a-gold-soft);color:var(--a-gold)"><svg class="i"><use href="#i-news"/></svg></div><span class="lbl">Novinky</span><svg class="i a-muted" width="18" height="18"><use href="#i-chev"/></svg></a>
    <a class="a-row" href="/settings"><div class="a-ico" style="background:var(--a-s2);color:var(--a-t2)"><svg class="i"><use href="#i-cog"/></svg></div><span class="lbl">Nastavenia</span><svg class="i a-muted" width="18" height="18"><use href="#i-chev"/></svg></a>
    <% if (me.isAdmin) { %><a class="a-row" href="/admin"><div class="a-ico" style="background:var(--a-s2);color:var(--a-t2)"><svg class="i"><use href="#i-list"/></svg></div><span class="lbl">Administrácia</span><svg class="i a-muted" width="18" height="18"><use href="#i-chev"/></svg></a><% } %>
  </div>
  <div class="a-card a-list a-menu" style="margin-top:10px">
    <a class="a-row" href="/logout"><div class="a-ico" style="background:rgba(240,71,106,.12);color:var(--a-bad)"><svg class="i"><use href="#i-logout"/></svg></div><span class="lbl" style="color:var(--a-bad)">Odhlásiť sa</span></a>
  </div>
  <div class="a-muted a-small" style="text-align:center;margin-top:16px"><a href="/podmienky">Podmienky</a> · <a href="/sukromie">Súkromie</a> · <a href="/kontakt">Kontakt</a></div>
</main>
<%- include('_foot') %>
