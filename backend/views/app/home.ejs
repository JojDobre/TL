<%- include('_head') %>
<header class="a-top">
  <a href="/app/profil"><%- include('_av', { u: me, size: 42, st: 'box-shadow:0 0 0 2px #080b14,0 0 0 3.5px rgba(124,92,255,.45)' }) %></a>
  <div style="flex:1;min-width:0"><div class="a-muted a-small" style="font-weight:600"><%= greeting %></div><div style="font:700 19px var(--a-disp)"><%= me.name %></div></div>
  <a class="a-ib" href="/app/pridat" aria-label="<%= t('add.aria') %>"><svg class="i"><use href="#i-plus"/></svg></a>
  <a class="a-ib" href="/app/notifikacie" aria-label="<%= t('title.noti') %>"><svg class="i"><use href="#i-bell"/></svg></a>
</header>
<main class="a-wrap a-in">
  <% if (deadline) { %>
  <a class="a-deadline a-press" href="/app/kolo/<%= deadline.roundId %>">
    <div class="k"><svg class="i" width="15" height="15"><use href="#i-clock"/></svg><%= t('home.deadline', { x: deadline.until }) %></div>
    <h3><%= deadline.leagueName %> · <%= deadline.roundName %></h3>
    <p><%= t('home.tippedOf', { a: deadline.tipped, b: deadline.total, m: tn(deadline.total, 'matchGen') }) %></p>
    <div class="bar"><i style="width:<%= deadline.pct %>%"></i></div>
    <span class="a-btn gold"><%= t('home.finish', { n: deadline.missing, m: tn(deadline.missing, 'match') }) %></span>
  </a>
  <% } else if (allTipped) { %>
  <a class="a-deadline a-press" href="/app/tipovat" style="background:linear-gradient(135deg,#0f7a55,#1fd497)">
    <div class="k"><svg class="i" width="15" height="15"><use href="#i-check"/></svg><%= t('home.allTipped') %></div>
    <h3><%= t('home.tippedN', { n: openCount, m: tn(openCount, 'match') }) %></h3>
    <p><%= t('home.canChange') %></p>
  </a>
  <% } else { %>
  <div class="a-deadline" style="background:linear-gradient(135deg,#1b2440,#232d47)">
    <div class="k"><svg class="i" width="15" height="15"><use href="#i-cal"/></svg><%= t('home.noOpen') %></div>
    <h3><%= t('home.nothing') %></h3>
    <p><%= t('home.joinNext') %></p>
    <a class="a-btn gold" href="/app/pridat"><%= t('home.find') %></a>
  </div>
  <% } %>

  <div class="a-bento">
    <div class="a-glass big">
      <div class="a-muted a-small" style="font-weight:700"><%= t('home.last7') %></div>
      <div>
        <div style="font:700 34px var(--a-disp);letter-spacing:-.02em"><%= week > 0 ? '+' : '' %><%= week %><span style="font-size:16px;color:var(--a-t3)"> <%= t('common.pts') %></span></div>
        <% if (spark) { %><svg class="a-spark" viewBox="0 0 120 34" style="stroke:var(--a-ok)"><path d="<%= spark %>"/></svg><% } %>
      </div>
      <% if (weekDiff !== 0) { %>
      <div style="font:700 12px var(--a-body);display:flex;align-items:center;gap:4px" class="<%= weekDiff > 0 ? 'a-up' : 'a-down' %>"><svg class="i" width="14" height="14"><use href="#i-<%= weekDiff > 0 ? 'up' : 'down' %>"/></svg><%= t(weekDiff > 0 ? 'home.more' : 'home.less', { n: Math.abs(weekDiff) }) %></div>
      <% } else { %><div class="a-muted a-small"><%= t('home.same') %></div><% } %>
    </div>
    <div class="a-glass sm"><div class="a-muted a-small" style="font-weight:700"><%= t('home.accuracy') %></div><div class="v"><%= accuracy != null ? accuracy + ' %' : '–' %></div></div>
    <div class="a-glass sm"><div class="a-muted a-small" style="font-weight:700"><%= t('home.best') %></div><div class="v" style="color:var(--a-gold)"><%= best ? best.rank + '.' : '–' %></div></div>
  </div>

  <div class="a-sec"><%= t('home.mySeasons') %> <a href="/app/rebricky"><%= t('title.ranks') %></a></div>
  <% if (!seasons.length) { %>
    <div class="a-card a-empty"><b><%= t('home.noLeagues') %></b><%= t('home.noLeaguesTx') %><div style="margin-top:14px"><a class="a-btn gold" href="/app/pridat"><%= t('home.browse') %></a></div></div>
  <% } %>
  <div class="a-bento" style="<%= seasons.length ? '' : 'margin-top:10px' %>">
  <% if (seasons.length) { %>
    <% var smalls = seasons.length - 1; seasons.forEach(function (c, i) { var wide = i > 0 && smalls % 2 === 1 && i === seasons.length - 1; %>
    <a class="bt a-press <%= i === 0 ? 'big' : '' %> <%= wide ? 'wide' : '' %>" href="<%= c.href %>" style="--bn:<%= c.grad %>" data-wm="<%= c.initials %>">
      <div class="bt-top">
        <%- include('_crest', { c: c }) %>
        <% if (c.untipped) { %><span class="bt-badge"><%= i === 0 ? t('home.toTip', { n: c.untipped }) : c.untipped %></span><% } %>
      </div>
      <div class="bt-name"><%= c.name %></div>
      <div class="bt-sub"><%= c.leagues %> <%= tn(c.leagues, 'league') %> · <%= c.players %> <%= tn(c.players, 'player') %></div>
      <div class="bt-foot">
        <b class="bt-rank"><%= c.bestRank ? c.bestRank + '.' : '–' %></b>
        <span class="bt-pts"><%= c.bestRank ? t('home.place') + ' · ' + c.points + ' ' + t('common.pts') : t('home.noRank') %></span>
        <% if (c.move) { %><span class="bt-move <%= c.move > 0 ? 'a-up' : 'a-down' %>"><svg class="i" width="13" height="13"><use href="#i-<%= c.move > 0 ? 'up' : 'down' %>"/></svg><%= Math.abs(c.move) %></span><% } %>
      </div>
    </a>
    <% }); %>
  <% } %>
    <a class="bt add a-press" href="/app/pridat"><svg class="i"><use href="#i-users"/></svg><span><%= t('home.joinCode') %></span></a>
    <a class="bt add a-press" href="/app/pridat?tab=vytvorit"><svg class="i"><use href="#i-plus"/></svg><span><%= t('home.create') %></span></a>
  </div>
  <% if (seasonsTotal > seasons.length) { %><a class="a-btn ghost" style="margin-top:10px" href="/app/rebricky"><%= t('home.allSeasons', { n: seasonsTotal }) %></a><% } %>
  <button type="button" class="a-howto a-press" data-tour-open><svg class="i"><use href="#i-info"/></svg><span><%= t('home.howItWorks') %></span><svg class="i" width="16" height="16"><use href="#i-chev"/></svg></button>
</main>
<div class="a-tour" data-tour hidden data-has="<%= seasons.length ? 1 : 0 %>">
  <div class="tour-card">
    <button type="button" class="tour-skip" data-tour-close><%= t('tour.skip') %></button>
    <div class="tour-track">
      <section class="tour-slide">
        <div class="tour-art"><img src="/branding/identity/tifo-mascot-512.webp" alt=""></div>
        <h2><%= t('tour.h1') %></h2><p><%= t('tour.p1') %></p>
      </section>
      <section class="tour-slide">
        <div class="tour-flow"><span><svg class="i"><use href="#i-trophy"/></svg><%= t('tour.season') %></span><i></i><span><svg class="i"><use href="#i-users"/></svg><%= t('tour.league') %></span><i></i><span><svg class="i"><use href="#i-ball"/></svg><%= t('tour.round') %></span></div>
        <h2><%= t('tour.h2') %></h2><p><%= t('tour.p2') %></p>
      </section>
      <section class="tour-slide">
        <div class="tour-score"><div class="st"><svg class="i"><use href="#i-up"/></svg><b>2</b><svg class="i"><use href="#i-down"/></svg></div><span>:</span><div class="st"><svg class="i"><use href="#i-up"/></svg><b>1</b><svg class="i"><use href="#i-down"/></svg></div></div>
        <h2><%= t('tour.h3') %></h2><p><%= t('tour.p3') %></p>
      </section>
      <section class="tour-slide">
        <div class="a-pts-list tour-pts">
          <div><span><%= t('liga.exact') %></span><b>10 <%= t('common.pts') %></b></div>
          <div><span><%= t('liga.winner') %></span><b>3 <%= t('common.pts') %></b></div>
          <div><span><%= t('liga.diff') %></span><b>2 <%= t('common.pts') %></b></div>
          <div><span><%= t('liga.goals') %></span><b>1 <%= t('common.pts') %></b></div>
        </div>
        <h2><%= t('tour.h4') %></h2><p><%= t('tour.p4') %></p>
      </section>
      <section class="tour-slide">
        <div class="tour-art gold"><svg class="i"><use href="#i-trophy"/></svg></div>
        <h2><%= t('tour.h5') %></h2><p><%= t('tour.p5') %></p>
        <% if (!seasons.length) { %><p class="tour-note"><%= t('tour.join') %></p><% } %>
      </section>
    </div>
    <div class="tour-dots"><i class="on"></i><i></i><i></i><i></i><i></i></div>
    <button type="button" class="a-btn gold" data-tour-next data-next="<%= t('tour.next') %>" data-last="<%= t(seasons.length ? 'tour.start' : 'tour.find') %>"><%= t('tour.next') %></button>
  </div>
</div>

<%- include('_foot') %>
