<%- include('_head') %>
<header class="a-top">
  <a class="a-ib" href="javascript:history.length>1?history.back():location.href='/app/suboje'" aria-label="<%= t('common.back') %>"><svg class="i"><use href="#i-back"/></svg></a>
  <div style="flex:1"></div>
  <a class="a-ib" href="/app/suboje" aria-label="<%= t('duel.title') %>"><svg class="i"><use href="#i-list"/></svg></a>
</header>
<main class="a-wrap a-in">
  <section class="a-duel-card <%= duel.result || duel.state %>">
    <a class="dc-eyebrow" href="/app/kolo/<%= round.id %>"><%= league.name %> · <%= round.name %></a>
    <div class="dc-vs">
      <div class="dc-p"><%- include('_av', { u: me, size: 72 }) %><b><%= t('duel.you') %></b></div>
      <div class="dc-mid">
        <div class="dc-score"><span class="<%= mine > theirs ? 'lead' : '' %>"><%= mine %></span><i>:</i><span class="<%= theirs > mine ? 'lead' : '' %>"><%= theirs %></span></div>
        <span class="a-pill <%= duel.result === 'win' ? 'ok' : (duel.state === 'live' ? 'warn' : (duel.state === 'pending' ? 'gold' : 'info')) %>"><%= duel.result ? t('duel.r.' + duel.result) : t('duel.s.' + (duel.incoming ? 'incoming' : duel.state)) %></span>
      </div>
      <div class="dc-p"><%- include('_av', { u: opp, size: 72 }) %><b><%= opp.name %></b></div>
    </div>
    <% if (duel.incoming) { %>
      <div class="dc-actions"><button class="a-btn gold" type="button" data-duel-act="accept" data-id="<%= duel.id %>"><%= t('duel.accept') %></button><button class="a-btn ghost" type="button" data-duel-act="decline" data-id="<%= duel.id %>"><%= t('duel.decline') %></button></div>
    <% } else if (duel.outgoing) { %>
      <p class="dc-note"><%= t('duel.waiting', { o: opp.name }) %></p>
      <div class="dc-actions"><button class="a-btn ghost" type="button" data-duel-act="cancel" data-id="<%= duel.id %>"><%= t('duel.cancel') %></button></div>
    <% } else if (duel.state === 'declined') { %>
      <p class="dc-note"><%= t('duel.declinedTx') %></p>
    <% } else if (share) { %>
      <div class="dc-actions"><button class="a-btn gold" type="button" data-share-card="<%= JSON.stringify(share) %>"><svg class="i" width="18" height="18"><use href="#i-share"/></svg><%= t('share.short') %></button><a class="a-btn ghost" href="/app/kolo/<%= round.id %>"><%= t('duel.toRound') %></a></div>
    <% } else { %>
      <div class="dc-actions"><a class="a-btn gold" href="/app/kolo/<%= round.id %>"><svg class="i" width="18" height="18"><use href="#i-ball"/></svg><%= t('noti.tip') %></a></div>
    <% } %>
  </section>

  <% if (matches.length) { %>
  <div class="a-sec"><%= t('duel.byMatch') %></div>
  <div class="a-card a-list">
    <% matches.forEach(function (m) { %>
    <div class="a-duel-m">
      <div class="dm-teams"><span><%= m.home.name %></span><b><%= m.result || (m.state === 'canceled' ? '—' : 'vs') %></b><span><%= m.away.name %></span></div>
      <div class="dm-tips">
        <span class="<%= m.myPts > 0 ? 'hit' : '' %>"><%= m.myTip || '–' %><% if (m.myJoker) { %> 🃏<% } %><% if (m.myPts != null) { %> <em>+<%= m.myPts %></em><% } %></span>
        <span class="dm-lbl"><%= t('duel.you') %> · <%= opp.name.split(' ')[0] %></span>
        <span class="<%= m.oppPts > 0 ? 'hit' : '' %>"><% if (m.oppTip === 'hidden') { %>🔒<% } else { %><%= m.oppTip || '–' %><% } %><% if (m.oppJoker) { %> 🃏<% } %><% if (m.oppPts != null) { %> <em>+<%= m.oppPts %></em><% } %></span>
      </div>
    </div>
    <% }); %>
  </div>
  <p class="a-muted a-small" style="text-align:center;margin-top:10px"><%= t('duel.hiddenNote') %></p>
  <% } %>
</main>
<script src="/js/share-card.js?v=<%= assetV %>" defer></script>
<%- include('_foot') %>
