# Port servera
PORT=3000
# Verejná adresa aplikácie (použije sa v návratových URL zo Stripe)
PUBLIC_URL=https://audit.mojadomena.sk
# Stripe – bez kľúča beží aplikácia v DEMO režime (objednávky bez platby!)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Kam ukladať objednávky, audity a PDF
DATA_DIR=./data
# Počet súbežne otvorených stránok v prehliadači
A11Y_CONCURRENCY=2
# Za reverse proxy (nginx, Caddy) – dôveruj hlavičke X-Forwarded-Proto
TRUST_PROXY=1
# Odosielanie e-mailov (len predplatné Monitoring) cez Resend – bez kľúča sa ukladajú do DATA_DIR/outbox
RESEND_API_KEY=re_...
MAIL_FROM=Web Analyzer <audit@mojadomena.sk>
# Prístup do /admin.html (aspoň 24 náhodných znakov) – bez neho je admin vypnutý
ADMIN_TOKEN=
# Ako dlho uchovávať objednávky a PDF správy (dni)
RETENTION_DAYS=180
# Názov služby (titulky, štruktúrované dáta, PDF). Po zmene spusti: npm run images
SITE_NAME=Web Analyzer
