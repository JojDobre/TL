{
  "name": "web-analyzer",
  "version": "1.1.0",
  "description": "Webová aplikácia na audit webu (bezpečnosť, SEO, výkon) a platený audit prístupnosti podľa EAA/WCAG s PDF správou.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-concurrency=1 'test/*.test.js'",
    "test:unit": "node --test test/unit.test.js",
    "benchmark": "node scripts/benchmark-w3c-bad.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "axe-core": "^4.10.0",
    "playwright": "1.48.2"
  }
}
